<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salary Slip - <%= payslipData.period.label %></title>
    <style>
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #111827;
            margin: 0;
            padding: 30px;
            font-size: 12px;
            line-height: 1.5;
        }

        .company-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .company-name {
            font-size: 24px;
            font-weight: bold;
            margin: 0;
        }

        .company-location {
            font-size: 11px;
            color: #6b7280;
            margin-top: 4px;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .title-bar {
            border-top: 1px solid #e5e7eb;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 0;
            margin-bottom: 25px;
            text-align: center;
        }

        .title-text {
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #374151;
            margin: 0;
        }

        .summary-container {
            display: flex;
            border: 1px solid #e5e7eb;
            margin-bottom: 25px;
        }

        .summary-left {
            flex: 1.5;
            padding: 15px;
            border-right: 1px solid #e5e7eb;
        }

        .summary-right {
            flex: 1;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background-color: #f9fafb;
        }

        .section-heading {
            font-size: 10px;
            font-weight: bold;
            color: #9ca3af;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .label-row {
            display: flex;
            margin-bottom: 6px;
        }

        .label {
            width: 40%;
            color: #6b7280;
            font-weight: bold;
        }

        .value {
            width: 60%;
            font-weight: bold;
        }

        .net-pay-amount {
            font-size: 28px;
            font-weight: bold;
            color: #111827;
            margin: 10px 0;
        }

        .chip {
            display: flex;
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
            color: #6b7280;
            text-transform: uppercase;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #e5e7eb;
            margin-bottom: 25px;
        }

        .table th {
            background-color: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px;
            text-align: left;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            color: #4b5563;
        }

        .table td {
            padding: 10px;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: top;
        }

        .border-right {
            border-right: 1px solid #e5e7eb;
        }

        .text-right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .text-rose {
            color: #e11d48;
        }

        .total-row {
            background-color: #f9fafb;
            font-weight: bold;
        }

        .total-row td {
            border-top: 1px solid #e5e7eb;
        }

        .net-summary-container {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 25px;
        }

        .net-summary-box {
            width: 45%;
            border: 1px solid #e5e7eb;
        }

        .net-summary-row {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            border-bottom: 1px solid #f3f4f6;
        }

        .net-summary-row.header {
            background-color: #f9fafb;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 10px;
            color: #4b5563;
        }

        .words-box {
            border: 1px solid #e5e7eb;
            background-color: #f9fafb;
            padding: 15px;
            text-align: center;
            margin-bottom: 30px;
        }

        .words-text {
            font-size: 14px;
            font-weight: bold;
        }

        .formula-text {
            margin-top: 10px;
            font-size: 9px;
            font-weight: bold;
            color: #9ca3af;
            text-transform: uppercase;
        }

        .footer {
            border-top: 1px solid #f3f4f6;
            padding-top: 20px;
            text-align: center;
            font-size: 9px;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 40px;
        }

        @media print {
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="company-header">
        <h1 class="company-name"><%= companyData.company_name || 'Airwix HRMS' %></h1>
        <div class="company-location"><%= companyData.address || 'Gujarat, India' %></div>
    </div>

    <div class="title-bar">
        <div class="title-text">Payslip for the month of <%= payslipData.period.label %></div>
    </div>

    <div class="summary-container">
        <div class="summary-left">
            <div class="section-heading">Employee Pay Summary</div>
            <div class="label-row">
                <div class="label">Employee Name</div>
                <div class="value">: <%= payslipData.employee.name %></div>
            </div>
            <div class="label-row">
                <div class="label">Employee Code</div>
                <div class="value">: <%= payslipData.employee.code || 'N/A' %></div>
            </div>
            <div class="label-row">
                <div class="label">Designation</div>
                <div class="value">: <%= payslipData.employee.designation || 'N/A' %></div>
            </div>
            <div class="label-row">
                <div class="label">Date of Joining</div>
                <div class="value">: <%= payslipData.employee.joining_date %></div>
            </div>
            <div class="label-row">
                <div class="label">Pay Period</div>
                <div class="value">: <%= payslipData.period.label %></div>
            </div>
            <div class="label-row">
                <div class="label">Pay Date</div>
                <div class="value">: <%= payslipData.period.payDate || 'N/A' %></div>
            </div>
            <% if (payslipData.attendance && payslipData.attendance.lunch_count > 0) { %>
            <div class="label-row">
                <div class="label">Lunch Count</div>
                <div class="value">: <%= payslipData.attendance.lunch_count %></div>
            </div>
            <% } %>
            <% if (payslipData.attendance && payslipData.attendance.leave_details) { %>
                <% Object.entries(payslipData.attendance.leave_details).forEach(([name, count]) => { %>
                <div class="label-row">
                    <div class="label"><%= name.charAt(0).toUpperCase() + name.slice(1).replace(/_/g, ' ') %></div>
                    <div class="value">: <%= count %></div>
                </div>
                <% }) %>
            <% } %>
        </div>

        <div class="summary-right">
            <div class="section-heading">Employee Net Pay</div>
            <div class="net-pay-amount"><%= formatCurrency(payslipData.salary.netPayable) %></div>
            <div class="chip">
                Paid Days: <%= payslipData.attendance.present %> | LOP Days: <%= payslipData.attendance.lwp %>
            </div>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th class="border-right" style="width: 30%;">Earnings</th>
                <th class="border-right text-right" style="width: 20%;">Amount</th>
                <th class="border-right" style="width: 30%;">Deductions</th>
                <th class="text-right" style="width: 20%;">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% 
                const earnings = payslipData.breakdown.earnings || [];
                const deductions = payslipData.breakdown.deductions || [];
                const maxRows = Math.max(earnings.length, deductions.length, 3);
            %>
            <% for (let i = 0; i < maxRows; i++) { %>
                <% const earn = earnings[i]; const ded = deductions[i]; %>
                <tr>
                    <td class="border-right"><%= earn ? earn.name : '' %></td>
                    <td class="border-right text-right bold"><%= earn ? formatCurrency(earn.actual_amount) : '' %></td>
                    <td class="border-right"><%= ded ? ded.name : '' %></td>
                    <td class="text-right bold text-rose"><%= ded ? formatCurrency(ded.amount) : '' %></td>
                </tr>
            <% } %>
            <tr class="total-row">
                <td class="border-right">Gross Earnings</td>
                <td class="border-right text-right"><%= formatCurrency(totalEarnings) %></td>
                <td class="border-right">Total Deductions</td>
                <td class="text-right text-rose"><%= formatCurrency(totalDeductions) %></td>
            </tr>
        </tbody>
    </table>

    <div class="net-summary-container">
        <div class="net-summary-box">
            <div class="net-summary-row header">
                <div>Net Pay</div>
                <div>Amount</div>
            </div>
            <div class="net-summary-row">
                <div>Gross Earnings</div>
                <div class="bold"><%= formatCurrency(totalEarnings) %></div>
            </div>
            <div class="net-summary-row">
                <div>Total Deductions</div>
                <div class="bold text-rose">(-) <%= formatCurrency(totalDeductions) %></div>
            </div>
            <div class="net-summary-row" style="background-color: #ffffff; border-top: 1px solid #e5e7eb;">
                <div class="bold">Total Net Payable</div>
                <div class="bold" style="font-size: 14px;"><%= formatCurrency(payslipData.salary.netPayable) %></div>
            </div>
        </div>
    </div>

    <div class="words-box">
        <div class="words-text">
            Total Net Payable: <%= formatCurrency(payslipData.salary.netPayable) %>
            <br>
            (<%= numberToWords(payslipData.salary.netPayable) %> Rupees Only)
        </div>
        <div class="formula-text">
            ** Total Net Payable = Gross Earnings - Total Deductions
        </div>
    </div>

    <div class="footer">
        -- This document has been automatically generated by Airwix HRMS; 
        therefore, a signature is not required. --
    </div>
</body>
</html>
