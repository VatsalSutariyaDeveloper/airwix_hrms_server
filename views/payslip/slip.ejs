<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salary Slip - <%= payslipData.period.label %></title>
    <!-- Use a clean sans-serif font that renders well in PDF -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

        body {
            font-family: 'Inter', 'Helvetica', 'Arial', sans-serif;
            color: #111827;
            margin: 0;
            padding: 20px;
            font-size: 9px;
            line-height: 1.4;
        }

        /* Header */
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 12px;
            border-bottom: 1px solid #cbd5e1;
            margin-bottom: 20px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .company-logo {
            max-height: 60px;
            max-width: 160px;
            object-fit: contain;
        }

        .company-info {
            display: flex;
            flex-direction: column;
        }

        .company-name {
            font-size: 24px;
            font-weight: 800;
            margin: 0;
            color: #1f2937;
        }

        .company-location {
            font-size: 12px;
            color: #4b5563;
            margin-top: 2px;
        }

        .header-right {
            text-align: right;
            display: flex;
            flex-direction: column;
        }

        .payslip-title {
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 4px;
        }

        .payslip-month {
            font-size: 16px;
            font-weight: 800;
            color: #111827;
        }

        /* Summary Box */
        .summary-container {
            display: flex;
            border: 1px solid #e5e7eb;
            margin-bottom: 20px;
        }

        .summary-left {
            flex: 1;
            padding: 10px;
            border-right: 1px solid #e5e7eb;
        }

        .summary-right {
            flex: 1;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .section-heading {
            font-size: 9px;
            font-weight: 700;
            color: #9ca3af;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .label-row {
            display: flex;
            margin-bottom: 5px;
        }

        .label {
            width: 45%;
            color: #6b7280;
            font-weight: 700;
        }

        .value {
            width: 55%;
            font-weight: 700;
        }

        .net-pay-amount {
            font-size: 22px;
            font-weight: 700;
            color: #111827;
        }

        /* Table Styles */
        .table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #e5e7eb;
            margin-bottom: 20px;
        }

        .table th {
            background-color: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 8px;
            text-align: left;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4b5563;
        }

        .table td {
            padding: 8px;
            border-bottom: 0.5px solid #f3f4f6;
            vertical-align: top;
            font-size: 9px;
            color: #374151;
        }

        .border-right {
            border-right: 1px solid #e5e7eb;
        }

        .text-right {
            text-align: right;
        }

        .bold {
            font-weight: 700;
        }

        .text-rose {
            color: #e11d48;
        }

        .total-row {
            background-color: #f9fafb;
            font-weight: 700;
            border-top: 1px solid #e5e7eb;
        }

        .total-row td {
            padding: 8px;
            text-transform: uppercase;
            color: #6b7280;
            letter-spacing: 1px;
        }

        .total-row .value-cell {
            color: #111827;
        }

        /* Reimbursements & Net Summary */
        .net-summary-container {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .net-summary-box {
            width: 48%;
            border: 1px solid #e5e7eb;
            background-color: #f9fafb;
        }

        .net-summary-row {
            display: flex;
            justify-content: space-between;
            padding: 8px;
            border-bottom: 0.5px solid #f3f4f6;
            font-size: 9px;
        }

        .net-summary-row.header {
            background-color: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 8px;
            color: #4b5563;
        }

        .net-summary-row.total {
            background-color: #ffffff;
            font-weight: 700;
            font-size: 11px;
        }

        /* Words Box */
        .words-box {
            border: 1px solid #e5e7eb;
            background-color: #f9fafb;
            padding: 12px;
            text-align: center;
            margin-bottom: 15px;
        }

        .words-text {
            font-size: 12px;
            font-weight: 700;
        }

        /* Footer */
        .footer {
            border-top: 1px solid #f3f4f6;
            padding-top: 8px;
            text-align: center;
            font-size: 7px;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            line-height: 1.5;
            font-weight: 600;
            margin-top: auto;
        }

        @media print {
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <% 
        // Logic to combine deductions and statutory from PayslipPdfDocument.tsx
        const normalize = (s) => String(s || "").toLowerCase().replace(/[^a-z0-9]/g, "");
        const baseDeductions = payslipData.breakdown.deductions || [];
        const statutoryDetails = payslipData.breakdown.statutory || {};
        const statutoryKeys = Object.keys(statutoryDetails).map(k => normalize(k));

        const combinedDeductions = [
            ...baseDeductions.filter(d => !statutoryKeys.includes(normalize(d.name))).map(d => ({ ...d, amount: d.amount, percentage: null })),
            ...Object.entries(statutoryDetails)
                .filter(([name]) => !name.endsWith(' %'))
                .map(([name, amount]) => {
                    const pKey = `${name} %`;
                    const percentage = statutoryDetails[pKey];
                    return { name, amount: amount, percentage: percentage };
                })
        ];

        const totalDeductionsCalculated = combinedDeductions.reduce((sum, d) => sum + parseFloat(d.amount || 0), 0);
        const earningsList = payslipData.breakdown.earnings || [];
        const maxRows = Math.max(earningsList.length, combinedDeductions.length, 3);

        const leaveBalances = payslipData.leave_balances || [];
        const reimbursements = payslipData.reimbursements || [];
        const netPayable = parseFloat(payslipData.salary.netPayable || 0);
    %>

    <div class="header-container">
        <div class="header-left">
            <% if (companyData.company_logo_url) { %>
                <img class="company-logo" src="<%= companyData.company_logo_url %>" alt="Logo" />
            <% } %>
            <div class="company-info">
                <h1 class="company-name"><%= companyData.company_name || 'Airwix HRMS' %></h1>
                <div class="company-location"><%= companyData.address || 'Gujarat, India' %></div>
            </div>
        </div>
        <div class="header-right">
            <div class="payslip-title">Payslip For the Month</div>
            <div class="payslip-month"><%= payslipData.period.label %></div>
        </div>
    </div>

    <div class="summary-container">
        <div class="summary-left">
            <div class="section-heading">Employee Pay Summary</div>
            <div class="label-row">
                <div class="label">Employee Name</div>
                <div class="value">: <%= payslipData.employee.name %></div>
            </div>
            <div class="label-row">
                <div class="label">Employee Code</div>
                <div class="value">: <%= payslipData.employee.code || '' %></div>
            </div>
            <div class="label-row">
                <div class="label">Designation</div>
                <div class="value">: <%= payslipData.employee.designation || '' %></div>
            </div>
            <div class="label-row">
                <div class="label">Date of Joining</div>
                <div class="value">: <%= payslipData.employee.joining_date %></div>
            </div>
            <div class="label-row">
                <div class="label">Pay Period</div>
                <div class="value">: <%= payslipData.period.label %></div>
            </div>
            <div class="label-row">
                <div class="label">Pay Date</div>
                <div class="value">: <%= payslipData.period.payDate || '' %></div>
            </div>
        </div>

        <div class="summary-right">
            <div class="section-heading">Employee Net Pay</div>
            <div class="net-pay-amount"><%= formatCurrency(netPayable) %></div>
            
            <div style="margin-top: 10px; display: inline-flex; border: 1px solid #e5e7eb; background-color: #f9fafb; padding: 4px 10px; border-radius: 12px; font-size: 8px; font-weight: 700; color: #6b7280; text-transform: uppercase;">
                <span>Paid Days : <%= payslipData.attendance.present %></span>
                <span style="margin: 0 6px;">|</span>
                <span>LOP Days : <%= payslipData.attendance.lwp %></span>
            </div>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th class="border-right" style="width: 30%;">Earnings</th>
                <th class="border-right text-right" style="width: 20%;">Amount</th>
                <th class="border-right" style="width: 30%;">Deductions</th>
                <th class="text-right" style="width: 20%;">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% for (let i = 0; i < maxRows; i++) { %>
                <% const earn = earningsList[i]; const ded = combinedDeductions[i]; %>
                <tr>
                    <td class="border-right"><%= earn ? earn.name : '' %></td>
                    <td class="border-right text-right bold"><%= earn ? formatCurrency(earn.amount) : '' %></td>
                    <td class="border-right">
                        <%= ded ? ded.name : '' %>
                        <% if (ded && ded.percentage) { %>(<%= ded.percentage %>%)<% } %>
                        <% if (ded && ded.is_food && ded.meal_count > 0) { %>
                            <span style="font-size: 7px;"> (<%= ded.meal_count %> meals x ₹<%= ded.rate %>)</span>
                        <% } %>
                    </td>
                    <td class="text-right bold text-rose"><%= ded ? formatCurrency(ded.amount) : '' %></td>
                </tr>
            <% } %>
            <tr class="total-row">
                <td class="border-right">Gross Earnings</td>
                <td class="border-right text-right value-cell"><%= formatCurrency(totalEarnings) %></td>
                <td class="border-right">Total Deductions</td>
                <td class="text-right text-rose value-cell"><%= formatCurrency(totalDeductionsCalculated) %></td>
            </tr>
        </tbody>
    </table>

    <% if (reimbursements && reimbursements.length > 0) { %>
    <table class="table">
        <thead>
            <tr>
                <th class="border-right" style="width: 70%;">Reimbursements</th>
                <th class="text-right" style="width: 30%;">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% reimbursements.forEach(item => { %>
                <tr>
                    <td class="border-right">
                        <span class="bold"><%= item.name %></span>
                        <% if (item.description) { %><span style="font-size: 7px; color: #6b7280;"> - <%= item.description %></span><% } %>
                    </td>
                    <td class="text-right bold"><%= formatCurrency(item.amount) %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>

    <div class="net-summary-container">
        <div class="net-summary-box">
            <div class="net-summary-row header">
                <div>Net Pay</div>
                <div class="text-right">Amount</div>
            </div>
            <div class="net-summary-row">
                <div>Gross Earnings</div>
                <div class="text-right"><%= formatCurrency(totalEarnings) %></div>
            </div>
            <div class="net-summary-row">
                <div>Total Deductions</div>
                <div class="text-right text-rose">(-) <%= formatCurrency(totalDeductionsCalculated) %></div>
            </div>
            <div class="net-summary-row total">
                <div class="bold">Total Net Payable</div>
                <div class="text-right bold"><%= formatCurrency(netPayable) %></div>
            </div>
        </div>
    </div>

    <div class="words-box">
        <div class="words-text">
            Total Net Payable : <%= formatCurrency(netPayable) %> (<%= numberToWords(netPayable) %> Only)
        </div>
    </div>

    <div class="footer">
        -- This document has been system generated;
        therefore, a signature is not required. --
    </div>
</body>
</html>
