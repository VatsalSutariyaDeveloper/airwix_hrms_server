<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reimbursement Slip - <%= data.formattedPeriod %></title>
    <!-- Use a clean sans-serif font that renders well in PDF -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

        body {
            font-family: 'Inter', 'Helvetica', 'Arial', sans-serif;
            color: #111827;
            margin: 0;
            padding: 20px;
            font-size: 9px;
            line-height: 1.4;
        }

        /* Header (Same as payslip design) */
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 12px;
            border-bottom: 1px solid #cbd5e1;
            margin-bottom: 20px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .company-logo {
            max-height: 60px;
            max-width: 160px;
            object-fit: contain;
        }

        .company-info {
            display: flex;
            flex-direction: column;
        }

        .company-name {
            font-size: 24px;
            font-weight: 800;
            margin: 0;
            color: #1f2937;
        }

        .company-location {
            font-size: 12px;
            color: #4b5563;
            margin-top: 2px;
        }

        .header-right {
            text-align: right;
            display: flex;
            flex-direction: column;
        }

        .slip-title {
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .slip-month {
            font-size: 16px;
            font-weight: 800;
            color: #111827;
        }

        /* Summary Box */
        .summary-container {
            display: flex;
            border: 1px solid #e5e7eb;
            margin-bottom: 20px;
        }

        .summary-left {
            flex: 1;
            padding: 10px;
            border-right: 1px solid #e5e7eb;
        }

        .summary-right {
            flex: 1;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .section-heading {
            font-size: 9px;
            font-weight: 700;
            color: #9ca3af;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .label-row {
            display: flex;
            margin-bottom: 5px;
        }

        .label {
            width: 45%;
            color: #6b7280;
            font-weight: 700;
        }

        .value {
            width: 55%;
            font-weight: 700;
        }

        .status-text-right {
            position: absolute;
            top: 10px;
            right: 12px;
            font-size: 9px;
            font-weight: 800;
            color: #047857;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .amount-label {
            font-size: 9px;
            font-weight: 700;
            color: #9ca3af;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .net-pay-amount {
            font-size: 22px;
            font-weight: 800;
            color: #111827;
        }

        /* Table Styles */
        .table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #e5e7eb;
            margin-bottom: 20px;
        }

        .table th {
            background-color: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 8px;
            text-align: left;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4b5563;
        }

        .table td {
            padding: 8px;
            border-bottom: 0.5px solid #f3f4f6;
            vertical-align: top;
            font-size: 9px;
            color: #374151;
        }

        .border-right {
            border-right: 1px solid #e5e7eb;
        }

        .text-right {
            text-align: right;
        }

        .bold {
            font-weight: 700;
        }

        /* Words Box */
        .words-box {
            border: 1px solid #e5e7eb;
            background-color: #f9fafb;
            padding: 12px;
            text-align: center;
            margin-bottom: 15px;
        }

        .words-text {
            font-size: 11px;
            font-weight: 700;
        }

        .remarks-text {
            font-size: 9px;
            color: #4b5563;
            margin-top: 5px;
        }

        /* Approved By Section */
        .approved-by-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 15px;
            padding-right: 5px;
            margin-bottom: 15px;
        }

        .approved-by-text {
            font-size: 10px;
            font-weight: 700;
            color: #374151;
        }

        /* Footer */
        .footer {
            border-top: 1px solid #f3f4f6;
            padding-top: 8px;
            text-align: center;
            font-size: 7px;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            line-height: 1.5;
            font-weight: 600;
            margin-top: auto;
        }

        @media print {
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <%
        const getPaymentMethodText = () => {
            if (data.payment_type === 1) return "Salary Addition";
            if (data.payment_type === 2) {
                return `Direct Payment (${data.payment_mode || "Bank"})`;
            }
            return "N/A";
        };

        const getStatusText = (status) => {
            switch (status) {
                case 0: return "Pending";
                case 1: return "Partially Approved";
                case 2: return "Deleted";
                case 3: return "Approved";
                case 4: return "Rejected";
                case 5: return "Cancelled";
                default: return "Unknown";
            }
        };
    %>

    <div class="header-container">
        <div class="header-left">
            <% if (companyData.company_logo_url) { %>
                <img class="company-logo" src="<%= companyData.company_logo_url %>" alt="Logo" />
            <% } %>
            <div class="company-info">
                <h1 class="company-name"><%= companyData.company_name || 'Airwix HRMS' %></h1>
                <div class="company-location"><%= companyData.address || 'Gujarat, India' %></div>
            </div>
        </div>
        <div class="header-right">
            <div class="slip-title">Reimbursement Slip</div>
            <div class="slip-month"><%= data.formattedPeriod %></div>
        </div>
    </div>

    <div class="summary-container">
        <div class="summary-left">
            <div class="section-heading">Reimbursement Details</div>
            <div class="label-row">
                <div class="label">Employee Name</div>
                <div class="value">: <%= data.employee?.first_name || '' %></div>
            </div>
            <div class="label-row">
                <div class="label">Employee Code</div>
                <div class="value">: <%= data.employee?.employee_code || '' %></div>
            </div>
            <div class="label-row">
                <div class="label">Applied On</div>
                <div class="value">: <%= data.formattedAppliedOn %></div>
            </div>
            <div class="label-row">
                <div class="label">Payment Method</div>
                <div class="value">: <%= getPaymentMethodText() %></div>
            </div>
        </div>

        <div class="summary-right">
            <!-- APPROVED label top right corner, no background green -->
            <!-- <span class="status-text-right" 
                  style="<%= data.approval_status === 4 ? 'color: #b91c1c;' : (data.approval_status === 0 ? 'color: #b45309;' : '') %>">
                <%= getStatusText(data.approval_status) %>
            </span> -->

            <div class="amount-label">Reimbursement Amount</div>
            <div class="net-pay-amount"><%= formatCurrency(data.total_amount) %></div>
        </div>
    </div>

    <div class="section-heading" style="margin-bottom: 5px;">Expense Items Breakdown</div>
    <table class="table">
        <thead>
            <tr>
                <th class="border-right" style="width: 8%;">S.No</th>
                <th class="border-right" style="width: 25%;">Expense Type</th>
                <th class="border-right" style="width: 17%;">Expense Date</th>
                <th class="border-right" style="width: 35%;">Description</th>
                <th class="text-right" style="width: 15%;">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% data.formattedItems.forEach((row, idx) => { %>
                <tr>
                    <td class="border-right"><%= idx + 1 %></td>
                    <td class="border-right"><%= row.expenseType?.name || 'Reimbursement' %></td>
                    <td class="border-right"><%= row.formattedDate %></td>
                    <td class="border-right"><%= row.description || 'No description provided' %></td>
                    <td class="text-right bold"><%= formatCurrency(row.amount) %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="words-box">
        <div class="words-text">
            Total Reimbursement : <%= formatCurrency(data.total_amount) %> (<%= numberToWords(data.total_amount) %> Rupees Only)
        </div>
        <% if (data.approval_remark) { %>
            <div class="remarks-text">
                Approval Remark: <%= data.approval_remark %>
            </div>
        <% } %>
    </div>

    <% if (data.approvedBy) { %>
        <div class="approved-by-container">
            <div class="approved-by-text">
                Approved By: <%= data.approvedBy.user_name || 'N/A' %>
            </div>
        </div>
    <% } %>

    <div class="footer">
        -- This document has been system generated;
        therefore, a signature is not required. --
    </div>
</body>
</html>
